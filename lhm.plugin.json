  "tools": [
    {
      "name": "db_info",
      "description": "查看当前数据库路径、SQLite 版本、读写模式和结果限制。",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "db_list_tables",
      "description": "分页列出业务表和视图，以及对应建表 SQL；不包含 SQLite 内部表。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "default": 100,
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "offset": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "db_describe_table",
      "description": "查看指定表或视图的字段、主键、默认值、索引、外键和建表 SQL。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "table": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "required": [
          "table"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "db_query",
      "description": "在独立只读连接上执行单条 SELECT、WITH 查询或 EXPLAIN。使用 ? 和 params 绑定值。默认最多返回 100 行，返回截断标记；大整数返回字符串，BLOB 返回 {base64}。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sql": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000,
            "description": "单条 SELECT、WITH 或 EXPLAIN 语句；绑定参数使用 ?。"
          },
          "params": {
            "default": [],
            "maxItems": 1000,
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "maxLength": 1048576
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "object",
                  "properties": {
                    "integer": {
                      "type": "string",
                      "maxLength": 20,
                      "pattern": "^-?(0|[1-9]\\d*)$"
                    }
                  },
                  "required": [
                    "integer"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "base64": {
                      "type": "string",
                      "maxLength": 1398104,
                      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                    }
                  },
                  "required": [
                    "base64"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          }
        },
        "required": [
          "sql"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
