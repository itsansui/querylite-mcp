{
  "description": "通过 MCP 为 Agent 提供本地 SQLite 查询、增删改查和事务能力。",
  "identifier": "querylite-mcp",
  "name": "querylite-mcp",
  "prompts": [],
  "resources": [],
  "tags": [
    "mcp",
    "sqlite",
    "database",
    "agent",
    "model-context-protocol"
