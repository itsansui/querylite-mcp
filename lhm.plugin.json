    {
      "name": "db_execute",
      "description": "执行一条写入 SQL 或建表、索引、视图 DDL。使用 ? 和 params。原始 UPDATE/DELETE 可以操作整表，请先确认范围；优先使用 db_update/db_delete。禁止 ATTACH、PRAGMA、扩展、触发器定义和手动事务。不返回 RETURNING 数据。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sql": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000
          },
          "params": {
            "default": [],
            "maxItems": 1000,
            "type": "array",
            "items": {
              "anyOf": [
